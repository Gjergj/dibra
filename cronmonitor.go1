package main

import (
	"context"
	"database/sql"
	"fmt"
	"time"
)

// CronJob represents a cron job configuration and its state
type CronJob struct {
	ID         string
	Name       string
	Schedule   string
	Command    string
	LastRun    time.Time
	NextRun    time.Time
	LastStatus string
	Duration   time.Duration
	RetryCount int
	LogFile    string
	AlertRules []AlertRule
	Timeout    time.Duration
	MaxRetries int
}

// CronExecution represents a single execution of a cron job
type CronExecution struct {
	JobID       string
	StartTime   time.Time
	EndTime     time.Time
	Status      string
	ExitCode    int
	Output      string
	Error       string
	ResourceUse ResourceUsage
}

// ResourceUsage tracks resource consumption
type ResourceUsage struct {
	CPUUsage    float64
	MemoryUsage uint64
	DiskIO      uint64
	NetworkIO   uint64
}

// AlertRule defines when to trigger alerts
type AlertRule struct {
	Condition  string
	Threshold  float64
	Comparator string
	AlertLevel string
	Channels   []string
}

// CronMonitor handles cron job monitoring
type CronMonitor struct {
	db      *sql.DB
	alerter Alerter
	metrics MetricsCollector
	logger  Logger
	config  MonitorConfig
}

// MonitorConfig holds monitoring configuration
type MonitorConfig struct {
	CheckInterval   time.Duration
	RetentionPeriod time.Duration
	MaxLogSize      int64
	AlertThresholds map[string]float64
}

// Monitor starts monitoring a cron job
func (cm *CronMonitor) Monitor(ctx context.Context, job CronJob) error {
	// 1. Schedule Monitoring
	go cm.monitorSchedule(ctx, job)

	// 2. Execution Monitoring
	go cm.monitorExecution(ctx, job)

	// 3. Resource Monitoring
	go cm.monitorResources(ctx, job)

	// 4. Log Monitoring
	go cm.monitorLogs(ctx, job)

	return nil
}

// monitorSchedule checks if jobs run according to schedule
func (cm *CronMonitor) monitorSchedule(ctx context.Context, job CronJob) {
	ticker := time.NewTicker(cm.config.CheckInterval)
	defer ticker.Stop()

	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			// Check if job ran when expected
			if job.NextRun.Before(time.Now()) && job.LastRun.Before(job.NextRun) {
				cm.alerter.Alert(Alert{
					Level:   "WARNING",
					Message: fmt.Sprintf("Job %s missed scheduled run at %v", job.Name, job.NextRun),
					Job:     job,
				})
			}

			// Update next expected run time
			job.NextRun = calculateNextRun(job.Schedule)
		}
	}
}

// monitorExecution tracks job execution
func (cm *CronMonitor) monitorExecution(ctx context.Context, job CronJob) {
	for {
		select {
		case <-ctx.Done():
			return
		default:
			execution := cm.detectJobExecution(job)
			if execution != nil {
				// Track execution time
				if execution.Duration() > job.Timeout {
					cm.alerter.Alert(Alert{
						Level:   "ERROR",
						Message: fmt.Sprintf("Job %s exceeded timeout of %v", job.Name, job.Timeout),
						Job:     job,
					})
				}

				// Check exit code
				if execution.ExitCode != 0 {
					cm.handleFailure(job, execution)
				}

				// Store execution history
				cm.storeExecution(execution)

				// Update metrics
				cm.updateMetrics(job, execution)
			}
			time.Sleep(time.Second)
		}
	}
}

// monitorResources tracks resource usage
func (cm *CronMonitor) monitorResources(ctx context.Context, job CronJob) {
	ticker := time.NewTicker(time.Second)
	defer ticker.Stop()

	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			usage := cm.collectResourceUsage(job)

			// Check CPU usage
			if usage.CPUUsage > cm.config.AlertThresholds["cpu"] {
				cm.alerter.Alert(Alert{
					Level:   "WARNING",
					Message: fmt.Sprintf("Job %s high CPU usage: %.2f%%", job.Name, usage.CPUUsage),
					Job:     job,
				})
			}

			// Check memory usage
			if usage.MemoryUsage > uint64(cm.config.AlertThresholds["memory"]) {
				cm.alerter.Alert(Alert{
					Level:   "WARNING",
					Message: fmt.Sprintf("Job %s high memory usage: %d MB", job.Name, usage.MemoryUsage/1024/1024),
					Job:     job,
				})
			}

			// Store resource metrics
			cm.metrics.StoreResourceMetrics(job.ID, usage)
		}
	}
}

// monitorLogs monitors job output logs
func (cm *CronMonitor) monitorLogs(ctx context.Context, job CronJob) {
	logWatcher := NewLogWatcher(job.LogFile)

	for {
		select {
		case <-ctx.Done():
			return
		case line := <-logWatcher.Lines():
			// Check for error patterns
			if containsError(line) {
				cm.alerter.Alert(Alert{
					Level:   "ERROR",
					Message: fmt.Sprintf("Job %s logged error: %s", job.Name, line),
					Job:     job,
				})
			}

			// Check log volume
			if logWatcher.Size() > cm.config.MaxLogSize {
				cm.alerter.Alert(Alert{
					Level:   "WARNING",
					Message: fmt.Sprintf("Job %s log file exceeds size limit", job.Name),
					Job:     job,
				})
			}

			// Store log entries
			cm.storeLogEntry(job.ID, line)
		}
	}
}

// Example usage
func ExampleCronMonitoring() {
	config := MonitorConfig{
		CheckInterval:   time.Minute,
		RetentionPeriod: 30 * 24 * time.Hour,
		MaxLogSize:      100 * 1024 * 1024, // 100MB
		AlertThresholds: map[string]float64{
			"cpu":    80.0, // 80% CPU
			"memory": 85.0, // 85% memory
			"disk":   90.0, // 90% disk
		},
	}

	monitor := NewCronMonitor(config)

	job := CronJob{
		ID:       "backup-job",
		Name:     "Daily Backup",
		Schedule: "0 0 * * *", // Daily at midnight
		Command:  "/usr/local/bin/backup.sh",
		Timeout:  4 * time.Hour,
		AlertRules: []AlertRule{
			{
				Condition:  "duration",
				Threshold:  14400, // 4 hours in seconds
				Comparator: ">",
				AlertLevel: "critical",
				Channels:   []string{"email", "slack"},
			},
		},
	}

	ctx := context.Background()
	monitor.Monitor(ctx, job)
}

// Metrics collection
type MetricsCollector interface {
	StoreResourceMetrics(jobID string, usage ResourceUsage)
	GetJobMetrics(jobID string, start, end time.Time) []ResourceUsage
	CalculateStatistics(jobID string) JobStatistics
}

// Job statistics
type JobStatistics struct {
	SuccessRate     float64
	AvgDuration     time.Duration
	MaxDuration     time.Duration
	AvgResourceUse  ResourceUsage
	FailurePatterns []string
}

// Alerting interface
type Alerter interface {
	Alert(Alert)
	SendReport(Report)
}

// Alert represents a monitoring alert
type Alert struct {
	Level   string
	Message string
	Job     CronJob
	Time    time.Time
}

// Report generation
func (cm *CronMonitor) GenerateReport(job CronJob, period time.Duration) Report {
	end := time.Now()
	start := end.Add(-period)

	executions := cm.getExecutions(job.ID, start, end)
	metrics := cm.metrics.GetJobMetrics(job.ID, start, end)
	stats := cm.metrics.CalculateStatistics(job.ID)

	return Report{
		Job:         job,
		Period:      period,
		Executions:  executions,
		Metrics:     metrics,
		Statistics:  stats,
		GeneratedAt: time.Now(),
	}
}
